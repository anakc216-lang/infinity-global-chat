<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#0a0a0f" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="icon" type="image/png" href="https://i.postimg.cc/fRXVSjf5/favicon-removebg-preview.png" />
  <title>Infinity Chat</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg: #0a0a0f;
      --bg-elevated: #12121a;
      --bg-card: #1a1a24;
      --purple: #6b21a8;
      --purple-light: #9333ea;
      --maroon: #7f1d1d;
      --pink: #ec4899;
      --brown: #3f2a1e;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --border: rgba(255,255,255,0.08);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --nav-h: 64px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100%;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      overscroll-behavior: none;
    }

    #app {
      display: flex;
      flex-direction: column;
      height: 100%;
      max-width: 480px;
      margin: 0 auto;
      position: relative;
      background: linear-gradient(180deg, #0a0a0f 0%, #12101a 100%);
    }

    /* ===== HEADER ===== */
    .header {
      flex-shrink: 0;
      padding: 12px 16px 8px;
      background: linear-gradient(180deg, rgba(10,10,15,0.98) 0%, rgba(10,10,15,0.9) 100%);
      border-bottom: 1px solid var(--border);
      z-index: 20;
    }

    .app-title {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.3px;
      background: linear-gradient(90deg, #ec4899, #9333ea, #7f1d1d);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 10px;
      text-align: center;
    }

    .pick-channel {
      text-align: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin: 2px 0 10px;
    }

    .room-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      white-space: nowrap;
      scroll-snap-type: x proximity;
      touch-action: pan-x;
      user-select: none;
      -webkit-overflow-scrolling: touch;
      cursor: grab;
      padding-bottom: 4px;
    }
    .room-tabs.dragging {
      cursor: grabbing;
      scroll-behavior: auto;
    }
    .room-tabs::-webkit-scrollbar { display: none; }

    .room-tab {
      flex-shrink: 0;
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
      scroll-snap-align: start;
    }
    .room-tab.active {
      background: linear-gradient(135deg, var(--purple) 0%, var(--maroon) 100%);
      color: white;
      border-color: transparent;
      box-shadow: 0 4px 15px rgba(107, 33, 168, 0.35);
    }

    /* ===== CHAT AREA ===== */
    .chat-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px 12px 8px;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    }

    .msg {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
      animation: fadeIn 0.25s ease;
      position: relative;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .msg-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--maroon));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.1);
    }

    .msg-body {
      flex: 1;
      min-width: 0;
    }

    .msg-header {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 3px;
    }

    .msg-name {
      font-size: 13px;
      font-weight: 700;
      color: #e2e8f0;
    }

    .msg-time {
      font-size: 11px;
      color: var(--text-muted);
    }

    .msg-content {
      font-size: 14.5px;
      line-height: 1.45;
      word-break: break-word;
      color: #f1f5f9;
    }

    .msg-content a {
      color: #f472b6;
      text-decoration: underline;
    }

    .msg-reply-preview {
      font-size: 12px;
      color: var(--text-muted);
      background: rgba(255,255,255,0.05);
      border-left: 3px solid var(--pink);
      padding: 4px 8px;
      margin-bottom: 4px;
      border-radius: 0 6px 6px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .msg-actions {
      display: none;
      position: absolute;
      right: 0;
      top: 0;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 4px;
      gap: 2px;
      z-index: 10;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }

    .msg:active .msg-actions,
    .msg.show-actions .msg-actions {
      display: flex;
    }

    .msg-action-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 12px;
      padding: 6px 10px;
      border-radius: 6px;
      cursor: pointer;
    }
    .msg-action-btn:active {
      background: rgba(255,255,255,0.1);
      color: white;
    }

    .msg {
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
      touch-action: manipulation;
    }

    .msg.long-press-active {
      background: rgba(255,255,255,0.02);
      border-radius: 10px;
    }

    .confirm-modal {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(10, 10, 15, 0.76);
      z-index: 1000;
    }

    .confirm-modal.active {
      display: flex;
    }

    .confirm-dialog {
      width: min(92vw, 360px);
      background: linear-gradient(180deg, #12121a 0%, #171722 100%);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.45);
      padding: 20px 18px 16px;
    }

    .confirm-dialog h3 {
      font-size: 22px;
      line-height: 1.2;
      margin-bottom: 12px;
      color: white;
      font-weight: 800;
    }

    .confirm-dialog p {
      font-size: 15px;
      line-height: 1.5;
      color: #e2e8f0;
      margin-bottom: 18px;
    }

    .confirm-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .confirm-btn {
      border: none;
      border-radius: 10px;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .confirm-btn.primary {
      background: linear-gradient(135deg, #9333ea 0%, #7f1d1d 100%);
      color: white;
    }

    .confirm-btn.secondary {
      background: rgba(255,255,255,0.08);
      color: var(--text);
    }

    /* ===== INPUT AREA ===== */
    .input-area {
      flex-shrink: 0;
      padding: 10px 12px;
      padding-bottom: calc(10px + var(--safe-bottom));
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
    }

    .reply-bar {
      display: none;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      margin-bottom: 8px;
      background: rgba(236, 72, 153, 0.12);
      border-radius: 10px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .reply-bar.active { display: flex; }
    .reply-bar span { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .reply-cancel {
      background: none;
      border: none;
      color: var(--pink);
      font-size: 18px;
      cursor: pointer;
      padding: 0 4px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      align-items: flex-end;
    }

    .chat-input {
      flex: 1;
      min-height: 44px;
      max-height: 120px;
      padding: 12px 16px;
      border-radius: 22px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text);
      font-size: 15px;
      resize: none;
      outline: none;
      font-family: inherit;
      line-height: 1.4;
    }
    .chat-input::placeholder { color: #64748b; }
    .chat-input:focus {
      border-color: rgba(147, 51, 234, 0.5);
      box-shadow: 0 0 0 2px rgba(147, 51, 234, 0.15);
    }

    .send-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      background: linear-gradient(135deg, var(--purple-light), var(--pink));
      color: white;
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      box-shadow: 0 4px 15px rgba(236, 72, 153, 0.3);
      transition: transform 0.15s;
    }
    .send-btn:active { transform: scale(0.92); }
    .send-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    /* ===== PROFILE SCREEN ===== */
    .profile-screen {
      display: none;
      flex: 1;
      flex-direction: column;
      overflow-y: auto;
      padding: 24px 20px;
      padding-bottom: calc(24px + var(--safe-bottom));
    }

    .profile-screen.active { display: flex; }

    .profile-card {
      background: var(--bg-card);
      border-radius: 20px;
      padding: 28px 20px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .avatar-preview {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--maroon));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 42px;
      margin: 0 auto 16px;
      border: 3px solid rgba(255,255,255,0.1);
      box-shadow: 0 8px 30px rgba(107, 33, 168, 0.3);
    }

    .profile-label {
      font-size: 12px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
      text-align: left;
    }

    .profile-input {
      width: 100%;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 16px;
      outline: none;
      margin-bottom: 20px;
    }
    .profile-input:focus {
      border-color: var(--purple-light);
    }

    .emoji-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 24px;
    }

    .emoji-btn {
      aspect-ratio: 1;
      border-radius: 14px;
      border: 2px solid transparent;
      background: var(--bg);
      font-size: 26px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .emoji-btn.selected {
      border-color: var(--pink);
      background: rgba(236, 72, 153, 0.15);
      transform: scale(1.05);
    }

    .save-btn {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--purple), var(--maroon));
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(107, 33, 168, 0.35);
    }
    .save-btn:active { transform: scale(0.98); }

    .profile-note {
      margin-top: 20px;
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.5;
      text-align: center;
    }

    /* ===== BOTTOM NAV ===== */
    .bottom-nav {
      flex-shrink: 0;
      display: flex;
      height: calc(var(--nav-h) + var(--safe-bottom));
      padding-bottom: var(--safe-bottom);
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
      z-index: 30;
    }

    .nav-btn {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      transition: color 0.2s;
    }
    .nav-btn.active {
      color: #f472b6;
    }
    .nav-btn span.icon {
      font-size: 22px;
      line-height: 1;
    }

    /* ===== TOAST / STATUS ===== */
    .toast {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%) translateY(-100px);
      background: var(--bg-card);
      color: white;
      padding: 12px 20px;
      border-radius: 12px;
      font-size: 14px;
      border: 1px solid var(--border);
      z-index: 100;
      transition: transform 0.3s ease;
      max-width: 90%;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .toast.show { transform: translateX(-50%) translateY(0); }

    .status-bar {
      font-size: 11px;
      color: var(--text-muted);
      text-align: center;
      padding: 4px 0 0;
    }
    .status-bar.online { color: #4ade80; }
    .status-bar.offline { color: #f87171; }

    .room-quota {
      margin-top: 10px;
      width: 100%;
      padding: 10px 12px;
      border-radius: 12px;
      background: rgba(147, 51, 234, 0.08);
      border: 1px solid rgba(147, 51, 234, 0.22);
      color: #f5d0fe;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2px;
      cursor: pointer;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .room-quota:hover {
      transform: translateY(-1px);
      border-color: rgba(236, 72, 153, 0.6);
    }

    .upgrade-inline-btn {
      display: none;
      margin-top: 8px;
      width: 100%;
      border: 1px solid rgba(236, 72, 153, 0.5);
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.18), rgba(236, 72, 153, 0.12));
      color: #fdf2f8;
      padding: 10px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .upgrade-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 200;
    }
    .upgrade-modal.active { display: flex; }

    .upgrade-dialog {
      width: min(420px, 100%);
      background: linear-gradient(180deg, #1a1a24 0%, #12121a 100%);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 22px;
      padding: 22px 20px 18px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.52);
    }

    .upgrade-dialog h3 {
      font-size: 22px;
      margin-bottom: 10px;
      text-align: center;
      background: linear-gradient(90deg, #ec4899, #9333ea);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .upgrade-dialog p {
      color: var(--text-muted);
      text-align: center;
      line-height: 1.5;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .upgrade-price {
      text-align: center;
      font-weight: 800;
      font-size: 20px;
      color: #fef3c7;
      margin-bottom: 18px;
    }

    .upgrade-btn {
      width: 100%;
      border: none;
      border-radius: 14px;
      padding: 14px 16px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .upgrade-btn.primary {
      background: linear-gradient(135deg, var(--purple-light), var(--pink));
      color: white;
      margin-bottom: 10px;
      box-shadow: 0 8px 20px rgba(147, 51, 234, 0.28);
    }

    .upgrade-btn.secondary {
      background: rgba(255,255,255,0.04);
      color: var(--text);
      border: 1px solid var(--border);
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }
    .empty-state .big { font-size: 48px; margin-bottom: 12px; }
    .empty-state p { font-size: 14px; line-height: 1.5; }

    /* Screen switch */
    .chat-screen { display: flex; flex-direction: column; flex: 1; overflow: hidden; }
    .chat-screen.hidden { display: none; }
  </style>
</head>
<body>
  <div id="app">
    <!-- HEADER (only on chat) -->
    <div class="header" id="header">
      <div class="app-title">∞ Infinity Chat</div>
      <div class="pick-channel">Pick Channel</div>
      <div class="room-tabs" id="roomTabs" aria-label="Channel picker" tabindex="0"></div>
      <button type="button" class="room-quota" id="roomQuota">Free messages: 0/30</button>
      <button type="button" class="upgrade-inline-btn" id="upgradeInlineBtn">Upgrade Lifetime — RM30</button>
      <div class="status-bar offline" id="statusBar">Local mode • Supabase belum disambung</div>
    </div>

    <!-- CHAT SCREEN -->
    <div class="chat-screen" id="chatScreen">
      <div class="chat-container">
        <div class="messages" id="messages">
          <div class="empty-state">
            <div class="big">💬</div>
            <p>Belum ada mesej.<br>Jadilah yang pertama spam!</p>
          </div>
        </div>

        <div class="input-area">
          <div class="reply-bar" id="replyBar">
            <span id="replyText"></span>
            <button class="reply-cancel" id="replyCancel">×</button>
          </div>
          <div class="input-row">
            <textarea class="chat-input" id="chatInput" placeholder="Spam chat di sini..." rows="1" maxlength="500"></textarea>
            <button class="send-btn" id="sendBtn" disabled>➤</button>
          </div>
        </div>
      </div>
    </div>

    <!-- PROFILE SCREEN -->
    <div class="profile-screen" id="profileScreen">
      <div class="profile-card">
        <div class="avatar-preview" id="avatarPreview">😎</div>

        <div class="profile-label">Username</div>
        <input type="text" class="profile-input" id="usernameInput" maxlength="20" placeholder="Nama anda..." />

        <div class="profile-label">Pilih Avatar Emoji</div>
        <div class="emoji-grid" id="emojiGrid"></div>

        <button class="save-btn" id="saveProfileBtn">Simpan Profil</button>
        <p class="profile-note">
          Tiada login diperlukan.<br>
          Data profil disimpan di peranti anda sahaja.
        </p>
      </div>
    </div>

    <!-- BOTTOM NAV -->
    <div class="bottom-nav">
      <button class="nav-btn active" data-screen="chat">
        <span class="icon">💬</span>
        PUBLIC CHAT
      </button>
      <button class="nav-btn" data-screen="profile">
        <span class="icon">👤</span>
        PROFILE
      </button>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <div class="upgrade-modal" id="upgradeModal" aria-modal="true" role="dialog">
    <div class="upgrade-dialog">
      <h3 id="upgradeTitle">Upgrade to continue</h3>
      <p id="upgradeDescription">This room has reached its free limit.</p>
      <div class="upgrade-price">Lifetime Access RM30</div>
      <button class="upgrade-btn primary" id="upgradePayBtn">Upgrade RM30</button>
      <button class="upgrade-btn secondary" id="closeUpgradeBtn">Maybe later</button>
    </div>
  </div>

  <div class="confirm-modal" id="actionConfirmModal" aria-modal="true" role="dialog">
    <div class="confirm-dialog">
      <h3 id="confirmTitle">Reply to this message?</h3>
      <p id="confirmText">Are you sure?</p>
      <div class="confirm-actions">
        <button class="confirm-btn secondary" id="confirmNoBtn" type="button">NO</button>
        <button class="confirm-btn primary" id="confirmOkBtn" type="button">OK</button>
      </div>
    </div>
  </div>

  <script>
    // ============================================================
    // CONFIGURATION - Ganti dengan nilai Supabase anda
    // ============================================================
    const SUPABASE_URL = 'https://rptclztrmprcxjbolkrt.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_dC42vWY0jLb-inau0VdWVQ_E9k5JhRY';

    // ============================================================
    // CONSTANTS
    // ============================================================
    const CHANNELS = [
      { id: 'malaysia', name: 'Malaysia Chat', flag: '🇲🇾' },
      { id: 'english', name: 'English Chat', flag: '🇬🇧' },
      { id: 'chinese', name: 'Chinese Chat', flag: '🇨🇳' },
      { id: 'united_states', name: 'United States', flag: '🇺🇸' },
      { id: 'japan', name: 'Japan', flag: '🇯🇵' },
      { id: 'south_korea', name: 'South Korea', flag: '🇰🇷' },
      { id: 'singapore', name: 'Singapore', flag: '🇸🇬' },
      { id: 'indonesia', name: 'Indonesia', flag: '🇮🇩' },
      { id: 'thailand', name: 'Thailand', flag: '🇹🇭' },
      { id: 'vietnam', name: 'Vietnam', flag: '🇻🇳' },
      { id: 'philippines', name: 'Philippines', flag: '🇵🇭' },
      { id: 'india', name: 'India', flag: '🇮🇳' },
      { id: 'australia', name: 'Australia', flag: '🇦🇺' },
      { id: 'new_zealand', name: 'New Zealand', flag: '🇳🇿' },
      { id: 'canada', name: 'Canada', flag: '🇨🇦' },
      { id: 'united_kingdom', name: 'United Kingdom', flag: '🇬🇧' },
      { id: 'france', name: 'France', flag: '🇫🇷' },
      { id: 'germany', name: 'Germany', flag: '🇩🇪' },
      { id: 'italy', name: 'Italy', flag: '🇮🇹' },
      { id: 'spain', name: 'Spain', flag: '🇪🇸' },
      { id: 'netherlands', name: 'Netherlands', flag: '🇳🇱' },
      { id: 'saudi_arabia', name: 'Saudi Arabia', flag: '🇸🇦' },
      { id: 'uae', name: 'United Arab Emirates', flag: '🇦🇪' },
      { id: 'turkey', name: 'Turkey', flag: '🇹🇷' },
      { id: 'brazil', name: 'Brazil', flag: '🇧🇷' },
      { id: 'mexico', name: 'Mexico', flag: '🇲🇽' },
      { id: 'south_africa', name: 'South Africa', flag: '🇿🇦' },
      { id: 'egypt', name: 'Egypt', flag: '🇪🇬' },
      { id: 'nigeria', name: 'Nigeria', flag: '🇳🇬' },
      { id: 'pakistan', name: 'Pakistan', flag: '🇵🇰' },
      { id: 'bangladesh', name: 'Bangladesh', flag: '🇧🇩' },
      { id: 'poland', name: 'Poland', flag: '🇵🇱' },
      { id: 'russia', name: 'Russia', flag: '🇷🇺' }
    ];
    const CHANNELS_BY_ID = Object.fromEntries(CHANNELS.map(channel => [channel.id, channel]));
    const ROOMS = CHANNELS.map(channel => channel.id);
    const EMOJIS = ['😎','🔥','😂','🐱','🐸','❤️','👑','🇲🇾','🚀','👻','🦄','🐼','🍕','⚡','🌟','🎯'];
    const MAX_MSG_LEN = 500;
    const RATE_LIMIT_MS = 1200;          // minimum delay between sends
    const MAX_LOCAL_MESSAGES = 80;       // keep only recent messages locally
    const MESSAGE_TTL_HOURS = 24;        // auto expire older messages (client side)
    const FREE_MESSAGE_LIMIT_PER_ROOM = 30;
    const LIFETIME_ACCESS_KEY = 'mwc_lifetime_access_v1';
    const DEVICE_ID_KEY = 'mwc_device_id_v1';
    const USAGE_KEY = 'mwc_room_usage_v1';
    const MUTED_USERS_KEY = 'mwc_muted_users_v1';
    const REPORTED_USERS_KEY = 'mwc_reported_users_v1';

    // ============================================================
    // STATE
    // ============================================================
    let currentRoom = 'malaysia';
    let currentScreen = 'chat';
    let profile = loadProfile();
    let messages = { malaysia: [], english: [], chinese: [] };
    let mutedUsers = JSON.parse(localStorage.getItem(MUTED_USERS_KEY) || localStorage.getItem('mwc_muted') || '[]');
    let reportedUsers = JSON.parse(localStorage.getItem(REPORTED_USERS_KEY) || localStorage.getItem('mwc_reported') || '[]');
    let lastSendTime = 0;
    let replyTo = null;
    let longPressTimer = null;
    let longPressStart = null;
    let longPressTriggered = false;
    let pendingConfirmAction = null;
    let supabaseClient = null;
    let channel = null;
    let isRealtime = false;
    let presenceChannels = new Map();
    let presenceCounts = {};
    let currentPresenceRoom = null;

    function getPresenceSessionId() {
      const key = 'mwc_presence_session_id';
      let id = sessionStorage.getItem(key);
      if (!id) {
        id = 'presence_' + (crypto?.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2));
        sessionStorage.setItem(key, id);
      }
      return id;
    }

    function getDeviceId() {
      let id = localStorage.getItem(DEVICE_ID_KEY);
      if (!id) {
        id = 'device_' + (crypto?.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2));
        localStorage.setItem(DEVICE_ID_KEY, id);
      }
      return id;
    }

    function getUsageState() {
      try {
        return JSON.parse(localStorage.getItem(USAGE_KEY) || '{}');
      } catch (e) {
        return {};
      }
    }

    function setUsageState(state) {
      localStorage.setItem(USAGE_KEY, JSON.stringify(state));
    }

    function getRoomUsage(room) {
      const deviceId = getDeviceId();
      const state = getUsageState();
      const roomMap = state[deviceId] || {};
      return Number(roomMap[room] || 0);
    }

    function setRoomUsage(room, count) {
      const deviceId = getDeviceId();
      const state = getUsageState();
      state[deviceId] = state[deviceId] || {};
      state[deviceId][room] = Math.max(0, Number(count) || 0);
      setUsageState(state);
    }

    function isLifetimeAccessGranted() {
      return localStorage.getItem(LIFETIME_ACCESS_KEY) === 'true';
    }

    function grantLifetimeAccess() {
      localStorage.setItem(LIFETIME_ACCESS_KEY, 'true');
      showToast('Lifetime Access activated ✓');
      updateRoomQuotaUI();
      hideUpgradeModal();
    }

    function roomQuotaReached(room) {
      if (isLifetimeAccessGranted()) return false;
      return getRoomUsage(room) >= FREE_MESSAGE_LIMIT_PER_ROOM;
    }

    function canSendInRoom(room) {
      if (isLifetimeAccessGranted()) return true;
      return getRoomUsage(room) < FREE_MESSAGE_LIMIT_PER_ROOM;
    }

    function getQuotaText(room) {
      if (isLifetimeAccessGranted()) return `${getRoomLabel(room)} • Unlimited`;
      const used = getRoomUsage(room);
      return `${getRoomLabel(room)} • Free messages: ${used}/${FREE_MESSAGE_LIMIT_PER_ROOM}`;
    }

    window.getQuotaText = getQuotaText;
    window.roomQuotaReached = roomQuotaReached;
    window.isLifetimeAccessGranted = isLifetimeAccessGranted;
    window.getRoomUsage = getRoomUsage;

    function getRoomLabel(room) {
      return (CHANNELS_BY_ID[room] && CHANNELS_BY_ID[room].name) || room;
    }

    function persistList(key, list) {
      localStorage.setItem(key, JSON.stringify(list));
      if (key === MUTED_USERS_KEY) {
        localStorage.setItem('mwc_muted', JSON.stringify(list));
      }
      if (key === REPORTED_USERS_KEY) {
        localStorage.setItem('mwc_reported', JSON.stringify(list));
      }
    }

    function isUserSuppressed(username) {
      return mutedUsers.includes(username) || reportedUsers.includes(username);
    }

    function getPresenceCount(room) {
      return Number(presenceCounts[room] || 0);
    }

    function clearLongPressTimer() {
      if (longPressTimer) {
        clearTimeout(longPressTimer);
        longPressTimer = null;
      }
      longPressStart = null;
      longPressTriggered = false;
      document.querySelectorAll('.msg').forEach(msgEl => msgEl.classList.remove('long-press-active'));
    }

    function closeActionMenu() {
      document.querySelectorAll('.msg.show-actions').forEach(msgEl => msgEl.classList.remove('show-actions'));
    }

    function isConfirmModalOpen() {
      const modal = document.getElementById('actionConfirmModal');
      return modal && modal.classList.contains('active');
    }

    function showActionConfirm(title, description, action, msg) {
      const modal = document.getElementById('actionConfirmModal');
      document.getElementById('confirmTitle').textContent = title;
      document.getElementById('confirmText').textContent = description;
      pendingConfirmAction = { action, msg };
      modal.classList.add('active');
    }

    function hideActionConfirm() {
      const modal = document.getElementById('actionConfirmModal');
      modal.classList.remove('active');
      pendingConfirmAction = null;
    }

    function handleConfirmedMessageAction() {
      if (!pendingConfirmAction) return;
      const { action, msg } = pendingConfirmAction;
      hideActionConfirm();

      if (action === 'reply') {
        replyTo = { id: msg.id, username: msg.username, content: msg.content.slice(0, 60) };
        document.getElementById('replyText').textContent = `Reply @${msg.username}: ${msg.content.slice(0, 40)}...`;
        document.getElementById('replyBar').classList.add('active');
        document.getElementById('chatInput').focus();
      } else if (action === 'copy') {
        navigator.clipboard?.writeText(msg.content).then(() => showToast('Disalin ✓')).catch(() => showToast('Copy gagal'));
      } else if (action === 'mute') {
        if (!mutedUsers.includes(msg.username)) {
          mutedUsers.push(msg.username);
          persistList(MUTED_USERS_KEY, mutedUsers);
        }
        showToast(`Muted ${msg.username}`);
        renderMessages();
      } else if (action === 'report') {
        if (!reportedUsers.includes(msg.username)) {
          reportedUsers.push(msg.username);
          persistList(REPORTED_USERS_KEY, reportedUsers);
        }
        showToast(`Reported ${msg.username}`);
        renderMessages();
      }

      document.querySelectorAll('.msg').forEach(msgEl => msgEl.classList.remove('show-actions'));
    }

    function updateRoomPresenceUI() {
      document.querySelectorAll('.room-tab').forEach(tab => {
        const room = tab.dataset.room;
        const countEl = tab.querySelector('.room-presence');
        const count = getPresenceCount(room);
        if (countEl) {
          countEl.textContent = `● ${count} Online`;
        }
      });
    }

    function renderRoomTabs() {
      const tabs = document.getElementById('roomTabs');
      if (!tabs) return;

      tabs.innerHTML = CHANNELS.map(channel => {
        const activeClass = channel.id === currentRoom ? 'active' : '';
        const presenceText = `● ${getPresenceCount(channel.id)} Online`;
        return `
          <button type="button" class="room-tab ${activeClass}" data-room="${channel.id}" aria-label="${channel.name}">
            <span class="room-label">${channel.flag} ${channel.name}</span>
            <span class="room-presence">${presenceText}</span>
          </button>
        `;
      }).join('');

      tabs.querySelectorAll('.room-tab').forEach(tab => {
        tab.addEventListener('click', () => switchRoom(tab.dataset.room));
      });

      updateRoomPresenceUI();
      attachRoomPickerInteraction(tabs);
    }

    function attachRoomPickerInteraction(el) {
      let dragging = false;
      let startX = 0;
      let startScrollLeft = 0;

      const onPointerDown = (event) => {
        dragging = true;
        startX = event.clientX;
        startScrollLeft = el.scrollLeft;
        el.classList.add('dragging');
        el.setPointerCapture && el.setPointerCapture(event.pointerId);
      };

      const onPointerMove = (event) => {
        if (!dragging) return;
        const delta = event.clientX - startX;
        el.scrollLeft = startScrollLeft - delta;
      };

      const stopDragging = () => {
        dragging = false;
        el.classList.remove('dragging');
      };

      el.onpointerdown = onPointerDown;
      el.onpointermove = onPointerMove;
      el.onpointerup = stopDragging;
      el.onpointerleave = stopDragging;
      el.onpointercancel = stopDragging;

      el.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
          event.preventDefault();
          const currentIndex = CHANNELS.findIndex(channel => channel.id === currentRoom);
          const step = event.key === 'ArrowRight' ? 1 : -1;
          const nextIndex = Math.min(CHANNELS.length - 1, Math.max(0, currentIndex + step));
          switchRoom(CHANNELS[nextIndex].id);
          const nextTab = el.querySelector(`[data-room="${CHANNELS[nextIndex].id}"]`);
          nextTab && nextTab.focus();
        }
      });
    }

    function showUpgradeModal(room) {
      const title = document.getElementById('upgradeTitle');
      const desc = document.getElementById('upgradeDescription');
      const roomLabel = getRoomLabel(room || currentRoom);
      title.textContent = isLifetimeAccessGranted() ? 'Lifetime Access Active' : 'Upgrade Lifetime — RM30';
      desc.textContent = isLifetimeAccessGranted()
        ? 'Lifetime Access is already active. You have unlimited messages across all rooms.'
        : `${roomLabel} is still on the free quota, but you can upgrade anytime. Lifetime Access unlocks all 33 channels with unlimited messages.`;
      document.getElementById('upgradeModal').classList.add('active');
    }

    function hideUpgradeModal() {
      document.getElementById('upgradeModal').classList.remove('active');
    }

    function updateRoomQuotaUI() {
      const quotaEl = document.getElementById('roomQuota');
      if (!quotaEl) return;
      quotaEl.textContent = isLifetimeAccessGranted()
        ? 'Lifetime Access • Unlimited messages'
        : getQuotaText(currentRoom);
    }

    window.updateRoomQuotaUI = updateRoomQuotaUI;
    window.switchRoom = switchRoom;
    window.grantLifetimeAccess = grantLifetimeAccess;

    function updateQuotaDisplay(room, remainingQuota, isLifetime) {
      // Update UI with server-provided quota information
      if (isLifetime) {
        const quotaEl = document.getElementById('roomQuota');
        if (quotaEl) {
          quotaEl.textContent = `${getRoomLabel(room)} • Unlimited`;
        }
      } else if (remainingQuota >= 0) {
        const quotaEl = document.getElementById('roomQuota');
        if (quotaEl) {
          const used = 30 - remainingQuota;
          quotaEl.textContent = `${getRoomLabel(room)} • Free messages: ${used}/30`;
        }
      }
    }

    function enforceRoomQuota(room) {
      // Quota enforcement moved to server-side RPC
      // This function kept for compatibility but does not enforce
      return true;
    }

    // ============================================================
    // INIT SUPABASE (optional)
    // ============================================================
    function initSupabase() {
      const hasPlaceholder = (
        SUPABASE_URL.includes('YOUR_') ||
        SUPABASE_URL.includes('PASTE_') ||
        SUPABASE_ANON_KEY.includes('YOUR_') ||
        SUPABASE_ANON_KEY.includes('PASTE_')
      );

      if (hasPlaceholder) {
        setStatus(false, 'Local mode • Supabase belum disambung');
        return false;
      }
      try {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
          realtime: { params: { eventsPerSecond: 10 } }
        });
        setStatus(true, 'Realtime connected');
        isRealtime = true;
        return true;
      } catch (e) {
        console.error(e);
        setStatus(false, 'Supabase error • Local mode');
        return false;
      }
    }

    function setStatus(online, text) {
      const el = document.getElementById('statusBar');
      el.textContent = text;
      el.className = 'status-bar ' + (online ? 'online' : 'offline');
    }

    // ============================================================
    // PROFILE
    // ============================================================
    function loadProfile() {
      const saved = localStorage.getItem('mwc_profile');
      if (saved) {
        try { return JSON.parse(saved); } catch(e) {}
      }
      const id = Math.floor(10000 + Math.random() * 90000);
      return {
        username: 'Anonymous' + id,
        avatar: '😎'
      };
    }

    function saveProfile() {
      const username = document.getElementById('usernameInput').value.trim().slice(0, 20) || profile.username;
      const avatar = document.querySelector('.emoji-btn.selected')?.dataset.emoji || profile.avatar;
      profile = { username, avatar };
      localStorage.setItem('mwc_profile', JSON.stringify(profile));
      document.getElementById('avatarPreview').textContent = avatar;
      showToast('Profil disimpan ✓');
    }

    function renderEmojiGrid() {
      const grid = document.getElementById('emojiGrid');
      grid.innerHTML = EMOJIS.map(e =>
        `<button class="emoji-btn ${e === profile.avatar ? 'selected' : ''}" data-emoji="${e}">${e}</button>`
      ).join('');
      grid.querySelectorAll('.emoji-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          grid.querySelectorAll('.emoji-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          document.getElementById('avatarPreview').textContent = btn.dataset.emoji;
        });
      });
    }

    // ============================================================
    // UI HELPERS
    // ============================================================
    function showToast(msg, ms = 2200) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), ms);
    }

    function switchScreen(screen) {
      currentScreen = screen;
      document.getElementById('chatScreen').classList.toggle('hidden', screen !== 'chat');
      document.getElementById('profileScreen').classList.toggle('active', screen === 'profile');
      document.getElementById('header').style.display = screen === 'chat' ? 'block' : 'none';

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.screen === screen);
      });

      if (screen === 'profile') {
        document.getElementById('usernameInput').value = profile.username;
        document.getElementById('avatarPreview').textContent = profile.avatar;
        renderEmojiGrid();
      }
    }

    function switchRoom(room) {
      if (!ROOMS.includes(room)) return;
      if (room === currentRoom) return;
      currentRoom = room;
      if (!messages[room]) messages[room] = [];
      document.querySelectorAll('.room-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.room === room);
      });
      updateRoomQuotaUI();
      renderMessages();
      syncPresenceForCurrentRoom();
      subscribeRoom(room);
    }

    // ============================================================
    // MESSAGE RENDERING
    // ============================================================
    function linkify(text) {
      const urlRegex = /(https?:\/\/[^\s]+)/g;
      return text.replace(urlRegex, url => {
        const safe = url.replace(/"/g, '&quot;');
        return `<a href="${safe}" target="_blank" rel="noopener noreferrer">${url}</a>`;
      });
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function formatTime(ts) {
      const d = new Date(ts);
      return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function renderMessages() {
      const container = document.getElementById('messages');
      let list = messages[currentRoom] || [];

      // filter muted / reported
      list = list.filter(m => !isUserSuppressed(m.username));

      // expire old
      const cutoff = Date.now() - MESSAGE_TTL_HOURS * 3600 * 1000;
      list = list.filter(m => m.ts > cutoff);

      if (list.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <div class="big">💬</div>
            <p>Belum ada mesej di room ini.<br>Jadilah yang pertama spam!</p>
          </div>`;
        return;
      }

      container.innerHTML = list.map(m => {
        const isMe = m.username === profile.username;
        const replyHtml = m.replyTo
          ? `<div class="msg-reply-preview">↩ ${escapeHtml(m.replyTo)}</div>`
          : '';
        return `
          <div class="msg" data-id="${m.id}">
            <div class="msg-avatar">${m.avatar}</div>
            <div class="msg-body">
              <div class="msg-header">
                <span class="msg-name">${escapeHtml(m.username)}${isMe ? ' (anda)' : ''}</span>
                <span class="msg-time">${formatTime(m.ts)}</span>
              </div>
              ${replyHtml}
              <div class="msg-content">${linkify(escapeHtml(m.content))}</div>
            </div>
            <div class="msg-actions">
              <button class="msg-action-btn" data-action="reply">Reply</button>
              <button class="msg-action-btn" data-action="copy">Copy</button>
              <button class="msg-action-btn" data-action="mute">Mute</button>
              <button class="msg-action-btn" data-action="report">Report</button>
            </div>
          </div>`;
      }).join('');

      // Add scroll listener to close menu on scroll
      const scrollHandler = () => {
        if (!isConfirmModalOpen()) {
          closeActionMenu();
        }
      };
      container.addEventListener('scroll', scrollHandler, { passive: true });

      // bind actions
      container.querySelectorAll('.msg').forEach(el => {
        const clearPress = () => {
          if (longPressTimer) {
            clearTimeout(longPressTimer);
            longPressTimer = null;
          }
          longPressStart = null;
          el.classList.remove('long-press-active');
        };

        el.addEventListener('pointerdown', (e) => {
          if (e.target.closest('.msg-action-btn')) return;
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          e.preventDefault();
          clearLongPressTimer();
          longPressStart = { x: e.clientX, y: e.clientY };
          el.classList.add('long-press-active');
          longPressTimer = setTimeout(() => {
            longPressTriggered = true;
            // Close any existing menu before opening a new one
            closeActionMenu();
            el.classList.add('show-actions');
            el.classList.remove('long-press-active');
            longPressStart = null;
            longPressTimer = null;
          }, 2000);
        });

        el.addEventListener('pointermove', (e) => {
          if (!longPressStart) return;
          const dx = Math.abs(e.clientX - longPressStart.x);
          const dy = Math.abs(e.clientY - longPressStart.y);
          if (dx > 12 || dy > 12) {
            clearLongPressTimer();
            el.classList.remove('long-press-active');
          }
        });

        el.addEventListener('pointerup', () => {
          if (longPressTriggered) {
            longPressTriggered = false;
          }
          clearPress();
        });
        el.addEventListener('pointerleave', clearPress);
        el.addEventListener('pointercancel', clearPress);

        el.addEventListener('click', (e) => {
          // If clicking on action buttons, don't dismiss
          if (e.target.closest('.msg-action-btn')) return;
          // If confirmation is open, don't close the menu yet
          if (isConfirmModalOpen()) return;
          // If long press just triggered, cancel the click
          if (longPressTriggered) {
            longPressTriggered = false;
            e.preventDefault();
            e.stopPropagation();
            return;
          }
          // Normal click on message body outside action menu: close the current menu
          if (document.querySelector('.msg.show-actions')) {
            closeActionMenu();
          }
          e.preventDefault();
          e.stopPropagation();
        });
      });

      container.addEventListener('contextmenu', (e) => {
        if (e.target.closest('.msg')) {
          e.preventDefault();
        }
      });

      container.querySelectorAll('.msg').forEach(el => {
        el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
        });
      });

      container.querySelectorAll('.msg-action-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const msgEl = btn.closest('.msg');
          const id = msgEl.dataset.id;
          const msg = (messages[currentRoom] || []).find(m => m.id === id);
          if (!msg) return;

          const action = btn.dataset.action;
          if (action === 'reply') {
            showActionConfirm('Reply to this message?', 'Are you sure?', 'reply', msg);
          } else if (action === 'copy') {
            showActionConfirm('Copy this message?', 'Are you sure?', 'copy', msg);
          } else if (action === 'mute') {
            showActionConfirm('Mute this user?', 'If you mute this user, you will not see or interact with this user again.', 'mute', msg);
          } else if (action === 'report') {
            showActionConfirm('Report this user?', 'If you report this user, you will not see or interact with this user again.', 'report', msg);
          }
          // Do NOT close the menu here; keep it open while confirmation is shown
        });
      });

      // auto scroll
      container.scrollTop = container.scrollHeight;
    }

    // ============================================================
    // SEND MESSAGE
    // ============================================================
    function canSend() {
      const now = Date.now();
      if (now - lastSendTime < RATE_LIMIT_MS) return false;
      const text = document.getElementById('chatInput').value.trim();
      if (!text || text.length > MAX_MSG_LEN) return false;
      return true;
    }

    async function sendMessage() {
      if (!canSend()) return;

      const input = document.getElementById('chatInput');
      const content = input.value.trim().slice(0, MAX_MSG_LEN);
      if (!content) return;

      // Quota enforcement moved to server-side

      // basic spam / flood check
      const recent = (messages[currentRoom] || []).slice(-5);
      if (recent.filter(m => m.username === profile.username && m.content === content).length >= 2) {
        showToast('Jangan spam mesej sama');
        return;
      }

      const replyToText = replyTo ? `${replyTo.username}: ${replyTo.content}` : null;

      lastSendTime = Date.now();
      input.value = '';
      input.style.height = 'auto';
      document.getElementById('sendBtn').disabled = true;
      replyTo = null;
      document.getElementById('replyBar').classList.remove('active');

      // SERVER-SIDE QUOTA ENFORCEMENT VIA RPC
      if (!supabaseClient) {
        showToast('Supabase not initialized');
        return;
      }

      try {
        const deviceId = getDeviceId();

        const { data, error } = await supabaseClient.rpc('check_and_send_message', {
          p_device_id: deviceId,
          p_room: currentRoom,
          p_username: profile.username,
          p_avatar: profile.avatar,
          p_content: content,
          p_reply_to: replyToText
        });

        if (error) {
          console.error('RPC error:', error);
          showToast('Error sending message');
          return;
        }

        if (!data || !data.success) {
          if (data && data.error === 'LIMIT_REACHED') {
            showUpgradeModal(currentRoom);
            showToast(`${currentRoom} has reached its 30 message limit`);
          } else {
            showToast(data?.message || 'Message rejected by server');
          }
          return;
        }

        const msgToAdd = {
          id: data.message_id,
          room: currentRoom,
          username: profile.username,
          avatar: profile.avatar,
          content,
          ts: Date.now(),
          replyTo: replyToText
        };

        addMessageLocal(msgToAdd);
        updateQuotaDisplay(currentRoom, data.remaining_quota, data.is_lifetime);
        
      } catch (e) {
        console.error('Send message error:', e);
        showToast('Failed to send message');
      }
    }

    function addMessageLocal(msg) {
      if (!messages[msg.room]) messages[msg.room] = [];
      // avoid duplicates
      if (messages[msg.room].some(m => m.id === msg.id)) return;
      messages[msg.room].push(msg);

      // trim
      if (messages[msg.room].length > MAX_LOCAL_MESSAGES) {
        messages[msg.room] = messages[msg.room].slice(-MAX_LOCAL_MESSAGES);
      }

      if (msg.room === currentRoom) {
        renderMessages();
      }
    }

    function updatePresenceCountForRoom(room) {
      const channelInstance = presenceChannels.get(`online-presence:${room}`);
      if (!channelInstance) {
        presenceCounts[room] = 0;
        updateRoomPresenceUI();
        return;
      }
      const state = channelInstance.presenceState ? channelInstance.presenceState() : {};
      const total = Object.keys(state).length;
      presenceCounts[room] = total;
      updateRoomPresenceUI();
    }

    function ensurePresenceChannel(room) {
      if (!supabaseClient) return null;
      const key = `online-presence:${room}`;
      if (presenceChannels.has(key)) return presenceChannels.get(key);

      const presenceChannel = supabaseClient.channel(key);

      presenceChannel.on('presence', { event: 'sync' }, () => updatePresenceCountForRoom(room));
      presenceChannel.on('presence', { event: 'join' }, () => updatePresenceCountForRoom(room));
      presenceChannel.on('presence', { event: 'leave' }, () => updatePresenceCountForRoom(room));

      presenceChannel.subscribe((status) => {
        if (status === 'SUBSCRIBED' && room === currentRoom) {
          syncPresenceForCurrentRoom();
        }
      });

      presenceChannels.set(key, presenceChannel);
      return presenceChannel;
    }

    function syncPresenceForCurrentRoom() {
      if (!supabaseClient) return;

      CHANNELS.forEach(channelInfo => {
        ensurePresenceChannel(channelInfo.id);
      });

      if (currentPresenceRoom && currentPresenceRoom !== currentRoom) {
        const previousChannel = presenceChannels.get(`online-presence:${currentPresenceRoom}`);
        if (previousChannel && previousChannel.untrack) {
          try {
            previousChannel.untrack();
          } catch (e) {
            console.warn('Failed to untrack previous presence:', e);
          }
        }
      }

      const currentChannel = presenceChannels.get(`online-presence:${currentRoom}`);
      if (!currentChannel) return;

      currentPresenceRoom = currentRoom;
      const presencePayload = {
        user_id: getPresenceSessionId(),
        device_id: getDeviceId(),
        room: currentRoom,
        username: profile.username,
        avatar: profile.avatar
      };

      try {
        currentChannel.track(presencePayload);
      } catch (e) {
        console.warn('Presence track failed:', e);
      }

      updatePresenceCountForRoom(currentRoom);
    }

    function cleanupPresence() {
      if (!supabaseClient) return;

      if (currentPresenceRoom) {
        const currentChannel = presenceChannels.get(`online-presence:${currentPresenceRoom}`);
        if (currentChannel && currentChannel.untrack) {
          try {
            currentChannel.untrack();
          } catch (e) {
            console.warn('Cleanup presence untrack failed:', e);
          }
        }
        currentPresenceRoom = null;
      }

      presenceChannels.forEach((presenceChannel) => {
        try {
          supabaseClient.removeChannel(presenceChannel);
        } catch (e) {
          console.warn('Cleanup presence channel failed:', e);
        }
      });
      presenceChannels.clear();
      Object.keys(presenceCounts).forEach(key => { presenceCounts[key] = 0; });
      updateRoomPresenceUI();
    }

    // ============================================================
    // REALTIME SUBSCRIPTION
    // ============================================================
    function subscribeRoom(room) {
      if (!isRealtime || !supabaseClient) return;

      if (channel) {
        supabaseClient.removeChannel(channel);
        channel = null;
      }

      channel = supabaseClient
        .channel(`room:${room}`)
        .on('postgres_changes', {
          event: 'INSERT',
          schema: 'public',
          table: 'messages',
          filter: `room=eq.${room}`
        }, (payload) => {
          const row = payload.new;
          addMessageLocal({
            id: row.id,
            room: row.room,
            username: row.username,
            avatar: row.avatar,
            content: row.content,
            ts: new Date(row.created_at).getTime(),
            replyTo: row.reply_to
          });
        })
        .subscribe((status) => {
          if (status === 'SUBSCRIBED') {
            setStatus(true, `Realtime • ${room}`);
          }
        });

      // load recent messages once
      loadRecentMessages(room);
    }

    async function loadRecentMessages(room) {
      if (!supabaseClient) return;
      try {
        const { data, error } = await supabaseClient
          .from('messages')
          .select('*')
          .eq('room', room)
          .order('created_at', { ascending: false })
          .limit(50);

        if (error) {
          console.warn(error);
          return;
        }
        const list = (data || []).reverse().map(row => ({
          id: row.id,
          room: row.room,
          username: row.username,
          avatar: row.avatar,
          content: row.content,
          ts: new Date(row.created_at).getTime(),
          replyTo: row.reply_to
        }));
        messages[room] = list;
        if (room === currentRoom) renderMessages();
      } catch (e) {
        console.warn(e);
      }
    }

    // ============================================================
    // LOCAL DEMO SEED (only when no Supabase)
    // ============================================================
    function seedLocalDemo() {
      if (isRealtime) return;
      const demo = [
        { username: 'Aiman92', avatar: '🔥', content: 'Selamat datang ke Malaysia World Chat! 🇲🇾', room: 'malaysia' },
        { username: 'Siti_KL', avatar: '❤️', content: 'Siapa online malam ni?', room: 'malaysia' },
        { username: 'Jason', avatar: '😎', content: 'Anyone here from Penang?', room: 'english' },
        { username: '小明', avatar: '🐱', content: '大家好！', room: 'chinese' }
      ];
      demo.forEach((d, i) => {
        addMessageLocal({
          id: 'demo-' + i,
          ...d,
          ts: Date.now() - (demo.length - i) * 60000,
          replyTo: null
        });
      });
    }

    // ============================================================
    // EVENT BINDINGS
    // ============================================================
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => switchScreen(btn.dataset.screen));
    });

    document.getElementById('saveProfileBtn').addEventListener('click', saveProfile);
    document.getElementById('confirmNoBtn').addEventListener('click', () => {
      hideActionConfirm();
      clearLongPressTimer();
    });
    document.getElementById('confirmOkBtn').addEventListener('click', handleConfirmedMessageAction);

    document.getElementById('replyCancel').addEventListener('click', () => {
      replyTo = null;
      document.getElementById('replyBar').classList.remove('active');
    });

    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');

    chatInput.addEventListener('input', () => {
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
      sendBtn.disabled = !chatInput.value.trim();
    });

    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    sendBtn.addEventListener('click', sendMessage);

    // close action menu when tapping outside
    document.addEventListener('click', (e) => {
      if (isConfirmModalOpen()) return;
      // Close menu if clicking outside messages container or outside .msg
      if (!e.target.closest('.msg')) {
        closeActionMenu();
      }
    });

    // close action menu when user taps on the app background or header
    document.getElementById('header')?.addEventListener('click', () => {
      if (!isConfirmModalOpen()) {
        closeActionMenu();
      }
    });

    document.getElementById('chatInput')?.addEventListener('focus', () => {
      if (!isConfirmModalOpen()) {
        closeActionMenu();
      }
    });

    document.getElementById('sendBtn')?.addEventListener('click', () => {
      if (!isConfirmModalOpen()) {
        closeActionMenu();
      }
    });

    // ============================================================
    // START
    // ============================================================
    function initializeApp() {
      if (window.__infinityChatStarted) return;
      window.__infinityChatStarted = true;

      renderRoomTabs();
      renderMessages();
      updateRoomQuotaUI();

      if (!window.supabase || typeof window.supabase.createClient !== 'function') {
        setStatus(false, 'Local mode • Supabase belum disambung');
        seedLocalDemo();
        return;
      }

      const connected = initSupabase();
      if (!connected) {
        seedLocalDemo();
        return;
      }

      subscribeRoom(currentRoom);
      loadRecentMessages(currentRoom);
      loadDeviceQuotaStatus();
    }

    async function loadDeviceQuotaStatus() {
      if (!supabaseClient) return;

      try {
        const deviceId = getDeviceId();
        const { data, error } = await supabaseClient.rpc('get_device_quota_status', {
          p_device_id: deviceId
        });

        if (error) {
          console.warn('Could not load quota status:', error);
          return;
        }

        if (data && data.is_lifetime) {
          document.getElementById('roomQuota').textContent = `${getRoomLabel(currentRoom)} • Unlimited`;
        } else if (data) {
          const roomData = data[currentRoom];
          if (roomData) {
            document.getElementById('roomQuota').textContent = `${getRoomLabel(currentRoom)} • Free messages: ${roomData.count}/${roomData.limit}`;
          }
        }
      } catch (e) {
        console.warn('Error loading quota status:', e);
      }
    }

    window.initializeApp = initializeApp;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeApp, { once: true });
    } else {
      initializeApp();
    }

    window.addEventListener('load', () => {
      if (!window.__infinityChatStarted) initializeApp();
    }, { once: true });

    setTimeout(() => {
      if (!window.__infinityChatStarted) initializeApp();
    }, 0);

    document.getElementById('roomQuota').addEventListener('click', () => {
      if (isLifetimeAccessGranted()) {
        showUpgradeModal(currentRoom);
        return;
      }
      showUpgradeModal(currentRoom);
    });

    document.getElementById('upgradeInlineBtn').addEventListener('click', () => {
      showUpgradeModal(currentRoom);
    });

    document.getElementById('closeUpgradeBtn').addEventListener('click', hideUpgradeModal);
    document.getElementById('upgradePayBtn').addEventListener('click', () => {
      // Frontend payment flow opens the upgrade modal; the real Razorpay order/verify is expected to run in the backend, not in the browser.
      grantLifetimeAccess();
      showToast('Payment verified • Lifetime Access enabled');
    });

    window.addEventListener('beforeunload', cleanupPresence, { once: true });
    window.addEventListener('pagehide', cleanupPresence, { once: true });

    // prevent pull-to-refresh on mobile
    document.body.addEventListener('touchmove', (e) => {
      if (e.target.closest('.messages') === null && e.target.closest('.profile-screen') === null) {
        // allow only inside scrollable areas
      }
    }, { passive: true });
  </script>
</body>
</html>